{
  "name": "serenity-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "projects": [
      {
        "displayName": "services",
        "testMatch": [
          "<rootDir>/src/services/__tests__/**/*.test.ts"
        ],
        "testEnvironment": "node",
        "transform": {
          "\\.[jt]sx?$": "babel-jest"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|firebase|@firebase)"
        ],
        "moduleNameMapper": {
          "^expo-constants$": "<rootDir>/src/__mocks__/expo-constants.ts",
          "^expo-modules-core$": "<rootDir>/src/__mocks__/expo-modules-core.ts",
          "^expo(.*)$": "<rootDir>/src/__mocks__/expo.ts"
        }
      },
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/src/**/__tests__/**/*.test.{ts,tsx}",
          "!<rootDir>/src/services/__tests__/**/*.test.ts"
        ]
      }
    ]
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "expo": "~54.0.33",
    "expo-background-fetch": "~14.0.9",
    "expo-battery": "~10.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "^55.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-sensors": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "firebase": "^12.11.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-google-mobile-ads": "^16.3.1",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^55.0.13",
    "jest": "^30.3.0",
    "jest-expo": "^55.0.11",
    "typescript": "~5.9.2"
  },
  "private": true
}
